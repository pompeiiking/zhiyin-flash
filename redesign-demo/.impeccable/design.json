  "narrative": {
    "northStar": "精确、安静、紧凑的学生工作空间",
    "overview": "当前视觉权威为运行实现、本文及 `design-review/navigation-rethink/BRIEF.md` 最后的2026-10-15完整产品重构契约。用户已撤销C2复刻要求，并授权整个学生端独立重构。参考截图和GenieLink仅解释品质期待，不规定构图，也不将范围缩为两个页面。根PRODUCT.md承载产品事实。\n\n信息以学生正在处理的任务为单位：比较展示差别，报告展示当前值和门槛，计划展示阶段与真实进度，日历展示日期与完整日程，记录展示可操作条目。共享的是尺度与控件，不是每页相同的大卡片。语言自然、中性、清楚。最新参考站Finsight的逐界面实地检查仍在进行，本规范不宣称它已完成。",
    "keyCharacteristics": [
      "浅灰工作底、白色任务表面、克制蓝色行动强调。",
      "分类导航与紧凑工具栏稳定，主体结构随任务变化。",
      "当前状态、真实名称、主要操作优先，短依据附近查看。",
      "四个获批机器人造型与独立采集变体承担实际身份和处理状态。"
    ],
    "rules": [
      {
        "name": "The Meaningful Accent Rule",
        "body": "主色必须对应当前状态、可执行动作或有尺度的真实数据。",
        "section": "colors"
      },
      {
        "name": "The Working Text Rule",
        "body": "真实名称和操作使用清晰可读的工作字号；元信息降级不能取代正文，进度必须保留数值含义。",
        "section": "typography"
      },
      {
        "name": "The Nearby Detail Rule",
        "body": "短解释、来源与小型选择保留触发上下文；长报告和文章使用独立阅读安排。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 用最终覆盖源码、实际字体与真实变更状态核对全站，而非只看初始截图。",
      "**Do** 让比较、阅读、日历、任务和记录使用适合各自用途的主体结构。",
      "**Do** 保留分类导航、键盘焦点、手机阅读顺序与真实状态反馈。",
      "**Do** 使用自然中性中文，显示真实任务名称、阶段目标和实际完成情况。"
    ],
    "donts": [
      "**Don't** 将C2历史、两张参考截图或不可用生成稿当成当前构图约束。",
      "**Don't** 将无名矩阵、重复大卡片或整页文章式说明作为通用解决方案。",
      "**Don't** 将服务契约、本地演示、合成刻度或停止响应说成在线成功或完成。",
      "**Don't** 将有限截图、专项检查或七项修复复核等同于全站品质终审或完整WCAG认证。"
    ]
  }
