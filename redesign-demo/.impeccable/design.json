  "narrative": {
    "overview": "当前前端的视觉权威是 `redesign-demo` 的运行实现与本规范。2026-10-15 用户确认全站重新设计，取消 C2 基准；以任务、结论、当前状态和下一步组织首屏，深入信息在触发位置附近查看。语言自然、中性、清楚。\n\n这是已实现系统的记录。标准导航保持稳定，成长档案提供连续记录与就近溯源的结构启发。没有获批视觉效果图或可用 Stitch 生成屏幕；历史原型不是当前验收基准。产品事实见根 `PRODUCT.md`。",
    "northStar": "清晰连续的个人工作空间",
    "dos": [
      "Do 用当前源码与实际路由截图核对规范，维护 token-bearing 文档及配套 sidecar。",
      "Do 首先呈现关键结论、当前状态和下一步，将短依据放在附近可操作的详情入口。",
      "Do 保留主色主题、独立深色覆盖、键盘焦点与手机内容顺序。",
      "Do 使用自然、中性、清楚的中文，以真实字段和状态派生读数。"
    ],
    "donts": [
      "Don't 以历史 C2 原型、旧截图或不存在的生成稿覆盖当前全站授权。",
      "Don't 将每段内容重新包装为统计卡片或重复解释栏。",
      "Don't 将本地演示、合成比较或契约数量描述为在线服务成功。",
      "Don't 将有限截图与行为检查等同于完整 WCAG、性能或真实后端验收。"
    ],
    "rules": [
      {
        "body": "主色表示当前入口或行动，注意色表示风险与待处理事项；在红主题中仍保留文字与结构区分状态。",
        "section": "colors",
        "name": "The Semantic Accent Rule"
      },
      {
        "body": "短解释、来源和小型筛选保留触发位置上下文，长任务与编辑流程仍使用合适的原有页面或面板。",
        "section": "elevation",
        "name": "The Nearby Detail Rule"
      }
    ],
    "keyCharacteristics": [
      "默认信息精简，操作和关键结论优先。",
      "连续内容以对齐、留白和细分隔组织。",
      "蓝或红主色、灰白底与独立深色覆盖。",
      "来源、短说明和筛选通过锚定浮层展开。"
    ]
  }
