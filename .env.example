# 职引 · 环境变量清单（部署前照着填；这里是**唯一**一份完整说明）
#
# 原则：**只有"服务启动之前必须知道"的东西才留在环境变量里。**
# 业务配置、AI 供应商与模型、功能开关、动态文案，全部入库
# （infra_ai_provider / infra_ai_model / infra_ai_route / infra_feature_flag /
#   biz_registry_item / infra_runtime_config）。
# 判断一条配置该不该进 env，只问一句：
#   "换一台机器，我在读到数据库之前需不需要知道它？"
#
# ⚠️ 谁覆盖谁（部署时最容易踩的一条）：
#   docker compose 的 environment: 里已经写死的变量（下面标了「compose 已设」），
#   以 compose 为准 —— 在 .env 里再写一遍不起作用。
#   例外：AUTH_JWT_SECRET 由 compose 从 .env 里**读出来**再注入（用于变量校验），
#   所以它必须写在 .env 里。
#
# 这份清单与代码一一对应：`Settings.from_env()`（zhiyin_boot/settings.py）读的
# 每一个变量都在下面出现，标「必填」的缺了服务起不来。


# ── 一、必填 ──────────────────────────────────────────────────────

# 令牌签名密钥。**唯一刻意留在 env 的密钥** —— 它保护库里其它数据，
# 放进库等于一份数据库导出就能伪造任意会话。至少 32 字符，生成一条：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
ZHIYIN_AUTH_JWT_SECRET=change-me-in-production-32bytes-min

# 加密密钥（AES-GCM，≥32 字节）。它保护的是库里的数据，所以不能和那些数据放在一起。
# 不填的后果是"security 能力位如实报骨架"，不是"假装加密了"。
# 上线后不要再改：换了它，已加密的内容就解不开。
# ZHIYIN_SECURITY_KEY=


# ── 二、部署级开关（读到库之前就要定，放库里会变成循环依赖）──────

ZHIYIN_USE_REMOTE_LLM=1            # 1 = 装配真模型客户端；0 = 只用本地骨架
ZHIYIN_USE_REMOTE_EMBEDDING=1      # 同上，管嵌入
# 遗留兼容：老的一键开关，等价于上面两条都开。新部署别用它。
# ZHIYIN_USE_REMOTE_AI=1


# ── 三、数据库与缓存 ─────────────────────────────────────────────

# 55432 = docker compose 里 postgres 发布到**回环**上的端口：宿主机直连与
# 容器内连的是同一个库（容器内写 postgres:5432）。
ZHIYIN_USE_POSTGRES=1                                                  # compose 已设
ZHIYIN_POSTGRES_DSN=postgresql://zhiyin:zhiyin@127.0.0.1:55432/zhiyin  # compose 已设

# ZHIYIN_USE_REDIS=1                        # compose 已设
# ZHIYIN_REDIS_URL=redis://redis:6379/0     # compose 已设
# ZHIYIN_REDIS_KEY_PREFIX=zhiyin            # compose 已设：键前缀，多环境共用一个 Redis 时区分
# ZHIYIN_AUTH_TOKEN_TTL_S=86400             # compose 已设：令牌有效期（秒）
# ZHIYIN_ENV=docker                         # compose 已设：只影响日志与装配报告里的显示


# ── 四、首次开机种子（表里有值之后可以整段删掉）──────────────────
#
# AI 供应商 / 模型 / 密钥在**第一次启动**时由这段写进 infra_ai_provider、
# infra_ai_model、infra_ai_route；之后**以库为准**：改配置改库，迁移只搬库。
# 验证方式：把下面这段全删掉再启动，服务照常跑 —— 说明它确实以库为准。

# ⚠️ 填**你自己的**模型密钥。发布件里这一行是空的（打包时会把仓库里那条清掉）——
#    密钥是你的，不该跟着包走；部署方各自填各自的。
ZHIYIN_LLM_API_KEY=
ZHIYIN_LLM_BASE_URL=https://api.deepseek.com
ZHIYIN_LLM_MODEL=deepseek-flash

# 嵌入：provider 决定装配哪个实现（ollama / doubao），后三项是给它的地址与模型。
# 容器里访问宿主用 host.docker.internal；直接在宿主机上跑（无容器）写 127.0.0.1。
# 本机 Ollama：qwen3-embedding:4b（2560 维真模型，不出网、不要密钥）
ZHIYIN_EMBEDDING_PROVIDER=ollama
ZHIYIN_EMBEDDING_API_KEY=ollama
ZHIYIN_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
ZHIYIN_EMBEDDING_MODEL=qwen3-embedding:4b
# 走云端豆包 Ark 时改成下面三行（接入点 id 形如 ep-…）
# ZHIYIN_EMBEDDING_PROVIDER=doubao
# ZHIYIN_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ZHIYIN_EMBEDDING_MODEL=ep-xxxxxxxxxxxxxxxx


# ── 五、可选能力位（配了才装真实现，没配就如实报"这个能力位没接"）──

# 通用网络搜索（Brave Search）。配了，主理手上才会多一条 web.search 工具。
#
# ⚠️ 它和「外部情报」不是一回事：情报是**爬公开页面**（学职平台 / 学信网），
#    不需要任何密钥，登录只影响能不能按画像收窄。
# 要开是两步：① 这里填 key；② 把 web.search 加回 data/registry/agents.json
#    的 career_advisor / info_scout 白名单。只做①会多出一个谁也不能用的工具。
# ZHIYIN_SEARCH_API_KEY=
# ZHIYIN_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search


# ── 六、一般不用改（默认即正确值）────────────────────────────────

# 外部站点地址与访问节流（秒）。**别往小调**：调小等于对人家站点加压。
# ZHIYIN_XUEZHI_BASE_URL=https://xz.chsi.com.cn
# ZHIYIN_XUEZHI_REQUEST_INTERVAL_S=0.25
# ZHIYIN_CHSI_BASE_URL=https://www.chsi.com.cn
# ZHIYIN_CHSI_REQUEST_INTERVAL_S=0.5

# 本地实现的数据目录（相对包根；容器内已有约定路径，改它要连着 Dockerfile 一起改）
# ZHIYIN_DATA_DIR=data
# ZHIYIN_OBJECT_DIR=data/objects
# ZHIYIN_REGISTRY_DIR=data/registry
# ZHIYIN_KNOWLEDGE_DIR=data/knowledge

# 日志级别：DEBUG / INFO / WARNING / ERROR
# ZHIYIN_LOG_LEVEL=INFO
