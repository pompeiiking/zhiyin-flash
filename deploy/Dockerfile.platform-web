FROM node:22-alpine AS build
WORKDIR /workspace/redesign-demo
COPY redesign-demo/package*.json ./
RUN npm ci --no-audit --no-fund
COPY redesign-demo/ ./
COPY zhiyin-src/template/zhiyin-modules/ /workspace/zhiyin-src/template/zhiyin-modules/
RUN npm run build
ARG BUILD_REVISION=working-tree
RUN node -e "require('fs').writeFileSync('dist/version.json', JSON.stringify({revision:process.env.BUILD_REVISION}))"
FROM nginx:1.27-alpine
COPY deploy/nginx.platform.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/redesign-demo/dist/ /usr/share/nginx/html/
EXPOSE 80
