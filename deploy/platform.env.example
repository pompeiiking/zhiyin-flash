# Copy to a private path outside the repository; fill locally on the target host.
PLATFORM_ENV=production
PLATFORM_REVISION=REPLACE_WITH_FULL_GIT_COMMIT
PLATFORM_WEB_PORT=8080
PLATFORM_API_PORT=8081
PLATFORM_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
ZHIYIN_AUTH_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DASHSCOPE_API_KEY=REPLACE_ON_TARGET_HOST
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Production does not accept local staging executor requests.
ZHIYIN_EXECUTOR_TOKEN=
