{
  "name": "zhiyin-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "职引正式前端（已选定 redesign 界面）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "sync:backend": "node scripts/sync-backend-types.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/types.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/api/types.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "motion-v": "^2.7.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vue-tsc": "^2.1.10",
    "openapi-typescript": "^6.7.0"
  },
  "overrides": {
    "undici": "^6.29.0"
  }
}
