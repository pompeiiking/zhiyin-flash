{
  "name": "zhiyin-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "职引 ZHIYIN · 前端（Vue 3 + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/types.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/api/types.ts"
  },
  "dependencies": {
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@number-flow/vue": "^0.5.2",
    "gsap": "^3.12.5",
    "misans": "^5.0.0",
    "motion": "^13.4.0",
    "motion-v": "^2.4.4",
    "pinia": "^2.1.7",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@vitejs/plugin-vue": "^5.0.4",
    "openapi-typescript": "^6.7.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.13"
  }
}
