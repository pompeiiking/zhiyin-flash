# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 测试与类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- 本地运行产物（第一期动态资源与对象存储的默认目录）----
# data/registry 与 data/knowledge 里是**需要入库演示的种子数据**，
# 必须提交；但运行时生成的对象与缓存不入库。
data/objects/
data/cache/
data/logs/
*.log
*.sqlite3
*.db

# ---- 前端 ----
node_modules/
dist-ssr/
*.local
.vite/

# ---- 编辑器与系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- 敏感配置 ----
# 只提交 .env.example；真实密钥、Token、数据库口令一律不入库。
.env
.env.*
!.env.example
*.pem
*.key

# ---- 迁移文件与发布件 ----
# 迁移文件里含 `infra_ai_provider.config.api_key`（模型密钥只存库，这是它的唯一副本），
# 是**要随发布件发给部署方**的东西，但绝不该进版本库。
deploy/migration.json
release/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
